{
  "name": "myynd",
  "version": "0.2.0",
  "description": "Myynd — dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:dritto": "MYYND_DEV=1 VITE_MYYND_DEV=1 npm run dev",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "test": "node --test --disable-warning=ExperimentalWarning server/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@notionhq/client": "^5.23.3",
    "express": "^5.2.1",
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "electron": "43.4.1",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  }
}
