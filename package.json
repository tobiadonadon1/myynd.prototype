{
  "name": "myynd",
  "version": "0.2.11",
  "description": "Myynd \u2014 dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:dritto": "MYYND_DEV=1 VITE_MYYND_DEV=1 npm run dev",
    "dev:server": "node --env-file-if-exists=.env.local --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.desktop.json",
    "test": "node --test --disable-warning=ExperimentalWarning server/*.test.ts src/*.test.ts desktop/*.test.ts",
    "start": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning server/index.ts",
    "password": "node --env-file-if-exists=.env.local --disable-warning=ExperimentalWarning server/password.ts",
    "app": "electron .",
    "app:dev": "MYYND_APP_WEB=http://127.0.0.1:5173 electron .",
    "pacchetto": "npm run build && electron-builder --config build/configura.cjs --mac --win",
    "pacchetto:mac": "npm run build && electron-builder --config build/configura.cjs --mac",
    "pacchetto:win": "npm run build && electron-builder --config build/configura.cjs --win --x64",
    "prova:app": "node prove/app.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@notionhq/client": "^5.23.3",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "imapflow": "^1.6.5",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "mammoth": "^1.12.0",
    "nodemailer": "^9.0.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "js-yaml": "4.3.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  },
  "main": "desktop/main.ts"
}
